{
  "name": "wexample/php-file",
  "description": "Reading a file tree, matching its paths and sizing its entries, framework-agnostic",
  "version": "1.1.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Wexample",
      "email": "contact@wexample.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpFile\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpFile\\Tests\\": "tests/"
    }
  }
}
